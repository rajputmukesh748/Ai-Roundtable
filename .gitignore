# ==============================================================================
# AI Roundtable - .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
[Tt]humbs.db
[Ee]hthumbs.db

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Environment Variables & Secrets (Keep .example files)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local
!*.example

# ------------------------------------------------------------------------------
# Backend (Python / FastAPI)
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Piper TTS voices & downloaded models
voices/
backend/voices/*.onnx
backend/voices/*.onnx.json
backend/voices/

# Audio / Temp outputs
*.wav
*.mp3

# Databases & local persistent state
*.sqlite3
*.db

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Frontend (Next.js / Node / TypeScript)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
frontend/.next/
out/

# TypeScript build cache
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Turbo & Vercel
.turbo/
.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
